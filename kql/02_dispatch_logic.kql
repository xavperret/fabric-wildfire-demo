// 02 — Logique de dispatch (clustering, priorisation par densité, choix du moyen)
// Seuils = valeurs de démo, à ajuster.
// Note: ref_communes est exposée via un shortcut OneLake depuis le Lakehouse.
//       Ses colonnes lat/lon sont renommées pour éviter les conflits avec FireDetections.

// (a) Regrouper les détections en foyers via cellules S2 (~niveau 12)
let FireZones =
    FireDetections
    | where ingest_ts > ago(6h)
    | extend cell = geo_point_to_s2cell(longitude, latitude, 12)
    | summarize frp_total = sum(frp), fire_lat = avg(latitude), fire_lon = avg(longitude),
                detections = count(), last_seen = max(ingest_ts) by cell;

// (b) Population menacée dans un rayon de 30 km (jointure croisée + distance géodésique)
let ZonesWithPop =
    FireZones
    | extend k = 1
    | join kind=inner (ref_communes | project commune, commune_lat=lat, commune_lon=lon, population | extend k = 1) on k
    | extend dist_m = geo_distance_2points(fire_lon, fire_lat, commune_lon, commune_lat)
    | where dist_m <= 30000
    | summarize pop_30km = sum(population), fire_lat = any(fire_lat), fire_lon = any(fire_lon),
                frp_total = any(frp_total), detections = any(detections) by cell;

// (c) Score de priorité + recommandation (aérien vs sol)
ZonesWithPop
| extend priority_score = round(frp_total * 1.0 + pop_30km / 100.0, 1)
| extend recommendation = case(
      frp_total > 50 and pop_30km < 500,  "AÉRIEN (Canadair) — foyer intense, faible densité",
      pop_30km >= 500,                     "SOL (SDIS) + AÉRIEN — enjeu habitations",
                                           "SOL (SDIS)")
| order by priority_score desc

// (d) Unité SDIS disponible la plus proche de chaque foyer
FireDetections
| where ingest_ts > ago(6h)
| extend cell = geo_point_to_s2cell(longitude, latitude, 12)
| summarize fire_lat = avg(latitude), fire_lon = avg(longitude) by cell
| extend k = 1
| join kind=inner (FirefighterUnits | where status == "available" | project unit_id, unit_type, unit_lat=cur_lat, unit_lon=cur_lon | extend k = 1) on k
| extend dist_km = round(geo_distance_2points(fire_lon, fire_lat, unit_lon, unit_lat) / 1000.0, 1)
| summarize (dist_km, unit_id, unit_type) = arg_min(dist_km, unit_id, unit_type) by cell, fire_lat, fire_lon
| order by dist_km asc
